{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/apcamargo/dprint-plugin-typstyle/releases/download/0.0.0/schema.json",
  "type": "object",
  "properties": {
    "lineWidth": {
      "description": "Maximum width of each line",
      "default": 80,
      "type": "integer",
      "minimum": 1
    },
    "indentWidth": {
      "description": "Number of spaces per indentation level",
      "default": 2,
      "type": "integer",
      "minimum": 0
    },
    "blankLinesUpperBound": {
      "description": "Maximum number of consecutive blank lines preserved",
      "default": 1,
      "type": "integer",
      "minimum": 0
    },
    "collapseMarkupSpaces": {
      "description": "Collapse consecutive whitespace in markup into a single space",
      "default": false,
      "type": "boolean"
    },
    "reorderImportItems": {
      "description": "Sort the items of an import statement alphabetically.",
      "default": true,
      "type": "boolean"
    },
    "wrapMode": {
      "description": "Text wrapping mode",
      "type": "string",
      "default": "none",
      "oneOf": [{
        "const": "none",
        "description": "Do not wrap text"
      }, {
        "const": "fill",
        "description": "Wrap text to fit within line width"
      }, {
        "const": "sentence",
        "description": "Place each sentence on its own line"
      }]
    },
    "lineEnding": {
      "description": "The line ending style to use when writing files",
      "type": "string",
      "default": "lf",
      "oneOf": [{
        "const": "lf",
        "description": "Line feed."
      }, {
        "const": "crlf",
        "description": "Carriage return, line feed."
      }]
    }
  }
}
